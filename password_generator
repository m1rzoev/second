import secrets
import string
import random

def generate_password(length: int, use_digits: bool, use_special: bool) -> str:
    """Генерирует надежный пароль заданной длины."""
    all_chars = string.ascii_letters
    password_chars = []

    # Гарантируем наличие хотя бы одного символа каждого выбранного типа
    password_chars.append(secrets.choice(string.ascii_letters))
    
    if use_digits:
        all_chars += string.digits
        password_chars.append(secrets.choice(string.digits))
        
    if use_special:
        all_chars += string.punctuation
        password_chars.append(secrets.choice(string.punctuation))

    # Добиваем пароль до нужной длины случайными символами
    remaining_length = length - len(password_chars)
    for _ in range(remaining_length):
        password_chars.append(secrets.choice(all_chars))

    # Перемешиваем символы
    random.SystemRandom().shuffle(password_chars)

    return ''.join(password_chars)

def main():
    print("=== ГЕНЕРАТОР ПАРОЛЕЙ ===")
    
    while True:
        try:
            length = int(input("\nВведите длину пароля (от 8 до 64): "))
            if length < 8 or length > 64:
                print("Ошибка: длина пароля должна быть от 8 до 64 символов.")
                continue
        except ValueError:
            print("Ошибка: пожалуйста, введите целое число.")
            continue

        use_digits = input("Использовать цифры? (y/n): ").strip().lower() == 'y'
        use_special = input("Использовать спецсимволы (!@#$%^&*)? (y/n): ").strip().lower() == 'y'

        password = generate_password(length, use_digits, use_special)
        
        print(f"\nВаш новый пароль: {password}")

        cont = input("\nСгенерировать еще один? (y/n): ").strip().lower()
        if cont != 'y':
            print("Выход. Берегите себя!")
            break

if __name__ == "__main__":
    main()
